/*
-------------------------------通道注册信息--------------------------------------
    UART_DEF(_COM_, _ENABLE, _UART_BASE, _GPIO_PORT, _PIN_TX, _PIN_TX_AF, _PIN_RX, _PIN_RX_AF, _DMA_TX_STREAM, _DMA_TX_CHANNEL, _DMA_RX_STREAM, _DMA_RX_CHANNEL)
    _COM_:           统一通道编号
    _ENABLE：        通道使能
    _UART_BASE：     串口寄存器基地址
    _GPIO_PORT：     GPIO端口基地址
    _PIN_TX：        发送管脚
    _PIN_TX_AF:      复用号
    _PIN_RX：        接收管脚
    _PIN_RX_AF:      复用号
    _DMA_TX_STREAM:  TX DMA流，不用DMA传0（中断收发）
    _DMA_TX_CHANNEL: TX DMA通道，不用DMA传0（中断收发）
    _DMA_RX_STREAM:  RX DMA流，不用DMA传0（中断收发）
    _DMA_RX_CHANNEL: RX DMA通道，不用DMA传0（中断收发）
********************************************************************************
*/

BEGIN_UART_CFG
    /* uart0 DEBUG: USART1 PA9/PA10，DMA2_Stream7发送/Stream2接收，Channel4 */
    UART_DEF(DRV_UART_COM_0, 1, USART1, GPIOA, GPIO_PIN_9, GPIO_AF7_USART1, GPIO_PIN_10, GPIO_AF7_USART1, DMA2_Stream7, DMA_CHANNEL_4, DMA2_Stream2, DMA_CHANNEL_4)
    /* uart1 RS232-U2: USART2 PA2/PA3，中断收发（预留） */
    UART_DEF(DRV_UART_COM_1, 1, USART2, GPIOA, GPIO_PIN_2, GPIO_AF7_USART2, GPIO_PIN_3, GPIO_AF7_USART2, 0, 0, 0, 0)
    /* uart2 RS232-U3: USART3 PB10/PB11，中断收发（Ymodem升级通道） */
    UART_DEF(DRV_UART_COM_2, 1, USART3, GPIOB, GPIO_PIN_10, GPIO_AF7_USART3, GPIO_PIN_11, GPIO_AF7_USART3, 0, 0, 0, 0)
END_UART_CFG
