/*
-------------------------------SPI通道注册信息-----------------------------------
    SPI_DEF(_COM_, _ENABLE, _SPI_BASE, _GPIO_PORT, _PIN_SCK, _PIN_SCK_AF, _PIN_MISO, _PIN_MISO_AF, _PIN_MOSI, _PIN_MOSI_AF, _PIN_CS, _DESC)
    _COM_:       统一通道编号
    _ENABLE:     通道使能
    _SPI_BASE:   SPI寄存器基地址
    _GPIO_PORT:  GPIO端口基地址
    _PIN_SCK:    SCK管脚
    _PIN_SCK_AF: SCK复用号
    _PIN_MISO:   MISO管脚
    _PIN_MISO_AF:MISO复用号
    _PIN_MOSI:   MOSI管脚
    _PIN_MOSI_AF:MOSI复用号
    _PIN_CS:     CS管脚，0为软件片选
    _DESC:       用途描述（注释用）
********************************************************************************
*/

BEGIN_SPI_CFG
    /* spi0 LCD/Flash总线: SPI1 PA5/PA6/PA7，软件片选（LCD/触摸屏挂载点） */
    SPI_DEF(DRV_SPI_COM_0, 1, SPI1, GPIOA, GPIO_PIN_5, GPIO_AF5_SPI1, GPIO_PIN_6, GPIO_AF5_SPI1, GPIO_PIN_7, GPIO_AF5_SPI1, 0, "lcd/flash bus")
END_SPI_CFG
